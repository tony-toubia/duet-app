{
  "rules": {
    "rooms": {
      // Index for querying old rooms for cleanup
      ".indexOn": ["createdAt"],

      "$roomCode": {
        // Only authenticated users can read room data (SDP contains IP addresses)
        ".read": "auth != null",

        // Anyone authenticated can CREATE a room; only its creator can
        // overwrite or delete the room wholesale. Members and signaling
        // children grant their own narrower writes below.
        ".write": "auth != null && (!data.exists() || data.child('createdBy').val() == auth.uid)",

        // Validate room structure (createdAt + createdBy required; additional fields allowed for party rooms)
        ".validate": "newData.hasChild('createdAt') && newData.hasChild('createdBy')",

        "createdAt": {
          ".validate": "newData.isNumber() && newData.val() <= now + 60000"
        },

        "createdBy": {
          ".validate": "newData.isString() && newData.val().length > 0"
        },

        "members": {
          "$memberId": {
            // Members can only add/remove THEMSELVES (onDisconnect inherits
            // auth from registration) — no ejecting other participants
            ".write": "auth != null && $memberId == auth.uid",
            ".validate": "newData.hasChildren(['role', 'joinedAt'])",

            "role": {
              ".validate": "newData.isString() && (newData.val() == 'offerer' || newData.val() == 'answerer' || newData.val() == 'host' || newData.val() == 'member')"
            },

            "joinedAt": {
              ".validate": "newData.isNumber()"
            },

            "heartbeat": {
              ".validate": "newData.isNumber()"
            }
          }
        },

        // WebRTC signaling data. These stay auth-writable (not member-gated)
        // because a joining guest clears stale signaling BEFORE registering
        // its member entry.
        "offer": {
          ".write": "auth != null",
          ".validate": "newData.hasChildren(['type', 'sdp'])",

          "type": {
            ".validate": "newData.isString() && newData.val() == 'offer'"
          },

          "sdp": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length < 20000"
          }
        },

        "answer": {
          ".write": "auth != null",
          ".validate": "newData.hasChildren(['type', 'sdp'])",

          "type": {
            ".validate": "newData.isString() && newData.val() == 'answer'"
          },

          "sdp": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length < 20000"
          }
        },

        "offerCandidates": {
          "$candidateId": {
            ".write": "auth != null",
            ".validate": "newData.hasChildren(['candidate', 'sdpMid', 'sdpMLineIndex'])",

            "candidate": {
              ".validate": "newData.isString() && newData.val().length < 1000"
            },

            "sdpMid": {
              ".validate": "newData.isString()"
            },

            "sdpMLineIndex": {
              ".validate": "newData.isNumber()"
            }
          }
        },

        "answerCandidates": {
          "$candidateId": {
            ".write": "auth != null",
            ".validate": "newData.hasChildren(['candidate', 'sdpMid', 'sdpMLineIndex'])",

            "candidate": {
              ".validate": "newData.isString() && newData.val().length < 1000"
            },

            "sdpMid": {
              ".validate": "newData.isString()"
            },

            "sdpMLineIndex": {
              ".validate": "newData.isNumber()"
            }
          }
        },

        // Party-mode per-pair signaling (offers/answers/candidates keyed by
        // '{fromUid}_{toUid}'). Needs its own write grant now that the
        // room-level write is restricted to the creator.
        "signaling": {
          ".write": "auth != null"
        }
      }
    },

    // User profiles and push tokens
    "users": {
      // No client reads of /users as a collection. Friend search by email
      // runs server-side (searchUserByEmail callable) and returns only uid,
      // display name and photo; a client query here used to expose the
      // matched user's whole record (email, push tokens, preferences).
      // Index kept for server-side (admin SDK) email queries.
      ".indexOn": ["profile/email"],

      "$userId": {
        // Your own data (tokens, preferences, persistent room) is yours alone
        ".read": "$userId == auth.uid",
        // Users can write their own data
        ".write": "$userId == auth.uid",

        "profile": {
          // Only display name and photo are visible to other signed-in users
          // (friends and room partners). Email and the rest of the profile
          // are readable by the owner only, via $userId/.read above.
          ".validate": "newData.hasChildren(['displayName'])",
          "displayName": {
            ".read": "auth != null",
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length < 100"
          },
          "email": {
            ".validate": "newData.isString() || newData.val() == null"
          },
          "avatarUrl": {
            ".read": "auth != null",
            ".validate": "newData.isString() || newData.val() == null"
          },
          "createdAt": {
            ".validate": "newData.isNumber()"
          },
          "authProvider": {
            ".validate": "newData.isString() && (newData.val() == 'google' || newData.val() == 'apple' || newData.val() == 'email' || newData.val() == 'anonymous')"
          },
          "friendCode": {
            ".validate": "newData.isString() && newData.val().length == 8"
          }
        },

        "pushToken": {
          ".validate": "newData.isString() && newData.val().length < 500"
        },

        "platform": {
          ".validate": "newData.isString() && (newData.val() == 'ios' || newData.val() == 'android')"
        },

        "tokens": {
          "$tokenId": {
            ".validate": "newData.hasChildren(['token', 'platform'])",
            "token": { ".validate": "newData.isString() && newData.val().length < 500" },
            "platform": { ".validate": "newData.isString() && (newData.val() == 'ios' || newData.val() == 'android' || newData.val() == 'web')" },
            "updatedAt": { ".validate": "newData.isNumber() || newData.val() == null" }
          }
        },

        "preferences": {
          "emailOptIn": {
            ".validate": "newData.isBoolean()"
          },
          "pushOptIn": {
            ".validate": "newData.isBoolean()"
          }
        },

        "persistentRoom": {
          ".validate": "newData.hasChildren(['partnerUid', 'partnerName'])",
          "partnerUid": { ".validate": "newData.isString()" },
          "partnerName": { ".validate": "newData.isString()" },
          "partnerAvatar": { ".validate": "newData.isString() || newData.val() == null" }
        }
      }
    },

    // Friends list
    "friends": {
      "$userId": {
        // Users can read their own friends list
        ".read": "$userId == auth.uid",

        "$friendId": {
          // The list owner can write their own entries. The other person may
          // only: remove the entry (unfriend/decline); create or refresh a
          // pending request they initiated; or accept a request the owner
          // sent them. A stranger can no longer mark themselves "accepted" in
          // someone's list (which would grant them that person's presence).
          ".write": "auth.uid == $userId || (auth.uid == $friendId && (!newData.exists() || (newData.child('status').val() == 'pending' && newData.child('initiatedBy').val() == auth.uid && (!data.exists() || data.child('status').val() == 'pending')) || (newData.child('status').val() == 'accepted' && data.child('initiatedBy').val() == $userId)))",
          ".validate": "newData.hasChildren(['status', 'displayName', 'initiatedBy'])",

          "status": {
            ".validate": "newData.isString() && (newData.val() == 'pending' || newData.val() == 'accepted')"
          },
          "displayName": {
            ".validate": "newData.isString()"
          },
          "avatarUrl": {
            ".validate": "newData.isString() || newData.val() == null"
          },
          "addedAt": {
            ".validate": "newData.isNumber()"
          },
          "initiatedBy": {
            ".validate": "newData.isString()"
          }
        }
      }
    },

    // Recent connections
    "recentConnections": {
      "$userId": {
        ".read": "$userId == auth.uid",
        ".write": "$userId == auth.uid",

        "$partnerId": {
          ".validate": "newData.hasChildren(['displayName', 'lastConnectedAt', 'roomCode'])"
        }
      }
    },

    // Presence/online status
    "status": {
      "$userId": {
        // Online status and last-seen are visible to the user and to their
        // accepted friends only (friend list online indicators)
        ".read": "auth != null && ($userId == auth.uid || root.child('friends').child($userId).child(auth.uid).child('status').val() == 'accepted')",
        // Only the user can write their own status
        ".write": "$userId == auth.uid",

        "state": {
          ".validate": "newData.isString() && (newData.val() == 'online' || newData.val() == 'offline')"
        },
        "lastSeen": {
          ".validate": "newData.isNumber()"
        }
      }
    },

    // Room invitations
    "invitations": {
      "$invitationId": {
        // Anyone authenticated can read invitations addressed to them
        ".read": "auth != null && data.child('toUid').val() == auth.uid",
        // Only the sender can create invitations (prevents spoofing)
        ".write": "auth != null && (!data.exists() || data.child('fromUid').val() == auth.uid) && newData.child('fromUid').val() == auth.uid",
        ".validate": "newData.hasChildren(['fromUid', 'fromDisplayName', 'toUid', 'roomCode', 'createdAt'])"
      }
    },

    // Friend codes reverse lookup: /friendCodes/{code} -> uid
    "friendCodes": {
      "$code": {
        ".read": "auth != null",
        // Only allow writing if the code doesn't exist yet, or the current user owns it
        ".write": "auth != null && (!data.exists() || data.val() == auth.uid)",
        ".validate": "newData.isString() && newData.val() == auth.uid"
      }
    },

    // Marketing platform — admin SDK only (no client access)
    "marketing": {
      ".read": false,
      ".write": false,

      "campaigns": {
        "$campaignId": {
          "status": { ".validate": "newData.isString()" },
          "createdAt": { ".validate": "newData.isNumber()" },
          "updatedAt": { ".validate": "newData.isNumber()" },
          "sentAt": { ".validate": "newData.isNumber() || newData.val() == null" }
        }
      },

      "segments": {
        "$segmentId": {
          "lastComputedAt": { ".validate": "newData.isNumber()" },
          "memberCount": { ".validate": "newData.isNumber()" }
        }
      },

      "journeys": {
        "$journeyId": {
          "enabled": { ".validate": "newData.isBoolean()" }
        }
      },

      "journeyState": {
        "$userId": {
          "$journeyId": {
            "startedAt": { ".validate": "newData.isNumber()" },
            "currentStep": { ".validate": "newData.isNumber()" },
            "lastStepAt": { ".validate": "newData.isNumber()" },
            "completed": { ".validate": "newData.isBoolean()" }
          }
        }
      },

      "sendLog": {
        ".indexOn": ["sentAt", "userId"],
        "$logId": {
          "sentAt": { ".validate": "newData.isNumber()" },
          "success": { ".validate": "newData.isBoolean()" }
        }
      }
    },

    // Email journey state — admin SDK only (no client access)
    "emailState": {
      ".read": false,
      ".write": false,
      ".indexOn": ["welcomeSentAt"],
      "$userId": {
        "welcomeSentAt": { ".validate": "newData.isNumber()" },
        "tipsSentAt": { ".validate": "newData.isNumber()" },
        "reengagementSentAt": { ".validate": "newData.isNumber()" },
        "hasCreatedRoom": { ".validate": "newData.isBoolean()" },
        "unsubscribed": { ".validate": "newData.isBoolean()" }
      }
    },

    // Event tracking — users can write their own events, admin SDK can read all
    "events": {
      ".read": false,
      "$userId": {
        ".read": "$userId == auth.uid",
        ".write": "$userId == auth.uid",
        "$eventType": {
          "$eventId": {
            ".validate": "newData.hasChildren(['type', 'timestamp'])",
            "type": { ".validate": "newData.isString()" },
            "timestamp": { ".validate": "newData.isNumber()" },
            "metadata": {
              "$key": { ".validate": "newData.isString()" }
            }
          }
        }
      }
    },

    // Rate limiting data — admin SDK only (managed by Cloud Functions)
    "rateLimits": {
      ".read": false,
      ".write": false
    },

    // Referral tracking
    "referrals": {
      "$userId": {
        ".read": "$userId == auth.uid",
        ".write": "$userId == auth.uid",
        "$referralId": {
          ".validate": "newData.hasChildren(['referredUid', 'referredAt'])",
          "referredUid": { ".validate": "newData.isString()" },
          "referredAt": { ".validate": "newData.isNumber()" },
          "referredName": { ".validate": "newData.isString()" }
        }
      }
    },

    // Content Hub — syndicated content
    "content_hub": {
      "items": {
        // Anyone authenticated can read content
        ".read": "auth != null",
        // Only admin SDK / Cloud Functions can write
        ".write": false
      },
      "config": {
        // Admin SDK only
        ".read": false,
        ".write": false
      },
      "sync_status": {
        // Authenticated users can read sync status (admin dashboard)
        ".read": "auth != null",
        // Only admin SDK can write
        ".write": false
      }
    },

    // Legacy World Cup content (kept for backwards compatibility)
    "worldcup": {
      ".read": "auth != null",
      ".write": false
    },

    // Deny access to everything else
    "$other": {
      ".read": false,
      ".write": false
    }
  }
}
